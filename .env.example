# Runtime mode used by local application processes.
APP_ENV=local

# Default structured logging level.
LOG_LEVEL=INFO

# Single local PDF used until multi-document corpus ingestion is connected.
DOCUMENT_PDF_PATH=data/raw/ai-security/kisa_ai_security_guide_ko_2026_corrected.pdf

# Lazy-loaded multilingual Cross-Encoder used by rerank and answer requests.
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# FastAPI address used by the Streamlit demo.
RAG_API_BASE_URL=http://127.0.0.1:8000
